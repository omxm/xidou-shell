#!/usr/bin/env sh
# Xidou Shell — xinit client script.
#
# Run by `startx` (via the xidou.desktop session entry) once Xorg is up on
# the real display. Not meant to be run inside Xephyr — see the repo README
# for the nested-server dev workflow instead.
#
# dwm owns the session: quickshell (the bar/panels) is started in the
# background first so the bar's strut geometry is in place before dwm's
# first arrange, then dwm becomes the foreground process. dwm exiting ends
# the X session, same as a normal xinitrc's `exec` convention.
set -eu

REPO_DIR="/home/haru/projects/xidou-shell"

[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources" 2>/dev/null

# --- external daemon dependencies -------------------------------------
# Every background service this shell needs but doesn't start itself gets
# a "check if running, start if not" line here, mirroring how MangoWM's
# own startup config already handles this — the single place this
# session's runtime dependencies live, so a fresh machine setup is "run
# this script" rather than hunting down what's missing piece by piece.
# See CLAUDE.md's Architecture section for the convention; add to this
# block as later phases (clipboard daemon, etc.) bring in new
# dependencies rather than starting them ad hoc elsewhere.
ensure_running() {
    # $1 = process name to check for (pgrep -x), $2.. = command to start it
    name="$1"
    shift
    if ! pgrep -x "$name" >/dev/null 2>&1; then
        "$@" &
    fi
}

# pipewire/wireplumber/pipewire-pulse are backgrounded with `&` below, not
# exec'd, so a plain relogin (xidouwm/X exiting, then this whole script
# re-running with a fresh dbus-daemon) never kills them -- they're
# reparented to PID 1 and linger bound to a D-Bus session address that no
# longer exists. wireplumber specifically needs a live bus to finish
# initializing (see below) and dies once its own bus disappears, but bare
# pipewire and pipewire-pulse tolerate a dead bus and keep running
# regardless -- so ensure_running's plain "is a process named X alive"
# check can't tell a healthy instance apart from one of these
# session-orphaned husks. After enough relogins, the process actually
# holding pipewire's socket can be exactly such an orphan, with no
# wireplumber behind it and therefore no real device tree/mixer/routing --
# confirmed empirically as the cause of a real "no audio" report.
#
# Fix: before starting anything, kill any pipewire/wireplumber/
# pipewire-pulse process whose own DBUS_SESSION_BUS_ADDRESS (frozen in its
# environment since the moment it was launched) doesn't match THIS
# session's freshly-started bus. What's left afterward is either nothing,
# or an instance that's still genuinely valid for this exact session.
reap_stale_audio_daemon() {
    name="$1"
    for pid in $(pgrep -x "$name" 2>/dev/null || true); do
        bus=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p')
        if [ "$bus" != "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
            kill "$pid" 2>/dev/null || true
        fi
    done
}

# Consumers before the producer -- not load-bearing (kill order doesn't
# matter for tearing down), just tidy.
reap_stale_audio_daemon pipewire-pulse
reap_stale_audio_daemon wireplumber
reap_stale_audio_daemon pipewire

# kill is asynchronous -- give reaped processes a moment to actually exit
# and release pipewire's socket before ensure_running below checks "is one
# already running". Escalate to SIGKILL if something's stuck rather than
# silently proceeding into the exact duplicate-instance state this whole
# block exists to prevent.
i=0
while [ "$i" -lt 25 ] && pgrep -x pipewire >/dev/null 2>&1; do
    sleep 0.2
    i=$((i + 1))
done
if pgrep -x pipewire >/dev/null 2>&1; then
    pkill -9 -x pipewire 2>/dev/null || true
fi

ensure_running pipewire pipewire
ensure_running pipewire-pulse pipewire-pulse

# WirePlumber needs a running pipewire to connect to and, critically, a
# valid session D-Bus address to finish initializing (its RTKit/dbus
# component fails without one) — starting it here, inside this session's
# own dbus-run-session context (see session/xidou.desktop's Exec line),
# gives it a real one rather than whatever a previous, possibly-dead
# session left behind (the reap step above is what makes "previous,
# possibly-dead session" not still be sitting on the socket by this point).
# Wait briefly for pipewire's socket rather than racing it with a blind
# sleep.
i=0
while [ "$i" -lt 25 ]; do
    if [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pipewire-0" ]; then
        break
    fi
    sleep 0.2
    i=$((i + 1))
done
ensure_running wireplumber wireplumber

# picom: without a compositing manager, X11 windows' alpha channels never
# actually get composited, so Quickshell's transparent PanelWindows (OSD,
# notifications, launcher) render their QML-drawn rounded corners as solid
# black wherever another window sits behind them instead of showing it
# through. See session/picom.conf for the (deliberately minimal) config.
ensure_running picom picom --config "$REPO_DIR/session/picom.conf"

# quickshell/services/MotionSync.qml needs picom.conf's real path to splice
# its motion-managed animations block and to scope its reload signal (pkill
# -f matched against this exact --config path, so an Xvfb test run pointed
# at a throwaway file never touches this real picom process). Same
# $XIDOU_CONFIG_PATH override convention Config.qml already uses.
export XIDOU_PICOM_CONF="$REPO_DIR/session/picom.conf"

# Clipboard history (Phase 7) -- clipnotify+xclip loop, per CLAUDE.md's
# explicit note on this exact dependency. Owns ~/.cache/xidou/clipboard/;
# quickshell/services/ClipboardHistory.qml only ever reads it.
# xidou-clipd is a shell script, so its process name is "sh" and
# ensure_running's `pgrep -x xidou-clipd` never matched: a new instance was
# started on every login whether one was running or not. Match the command
# line instead (bin/xidou-health uses the same pattern).
pgrep -u "$(id -u)" -f '/xidou-clipd$' >/dev/null 2>&1 || xidou-clipd &
# ------------------------------------------------------------------------

# Restore the last-selected wallpaper. quickshell/wallpaper/Wallpaper.qml
# sets the X11 root background via `feh --bg-fill`, which is a live X
# property with no memory of its own across a session restart -- feh
# already writes ~/.fehbg (its own standard restore script) on every
# selection, this was just never sourced back on startup, so a fresh X
# session always came up with a blank background until a wallpaper was
# reselected by hand. One-shot action, not a background service, so it
# doesn't belong in the ensure_running block above.
[ -f "$HOME/.fehbg" ] && sh "$HOME/.fehbg"

quickshell -p "$REPO_DIR/quickshell" &

# Window gaps ([layout] in config.toml) -- a real dwm feature (see
# xidouwm/fibonacci.c), so it can only be applied by talking to dwm's own IPC
# socket, not by anything Quickshell-side. Backgrounded (not exec'd) so it
# doesn't disturb dwm remaining the foreground/session-owning process below
# -- it just waits until dwm answers on its IPC socket, pushes the config
# values in once, and exits. Falls back to config.h's own gappih/gappoh
# defaults (5/5) if config.toml has no [layout] table yet or dwm never
# answers.
#
# It waits on a real query rather than on the socket file existing, so it
# needs no copy of the socket path rules (xidouwm/sockpath.h; the path is
# `xidouwm-msg --socket-path`), and a stale socket file left by a crashed
# session can't make it push too early.
(
    i=0
    until xidouwm-msg get_tags >/dev/null 2>&1; do
        i=$((i + 1))
        [ "$i" -lt 25 ] || exit 0
        sleep 0.2
    done

    config_toml="$HOME/.config/xidou/config.toml"
    [ -f "$config_toml" ] || exit 0

    gap_inner=$(awk -F= '
        /^\[layout\]/ { in_layout = 1; next }
        /^\[/ { in_layout = 0 }
        in_layout && $1 ~ /^[[:space:]]*gap_inner[[:space:]]*$/ {
            gsub(/[^0-9]/, "", $2); print $2; exit
        }' "$config_toml")
    gap_outer=$(awk -F= '
        /^\[layout\]/ { in_layout = 1; next }
        /^\[/ { in_layout = 0 }
        in_layout && $1 ~ /^[[:space:]]*gap_outer[[:space:]]*$/ {
            gsub(/[^0-9]/, "", $2); print $2; exit
        }' "$config_toml")

    [ -n "$gap_inner" ] && xidouwm-msg --ignore-reply run_command setgappih "$gap_inner" >/dev/null 2>&1
    [ -n "$gap_outer" ] && xidouwm-msg --ignore-reply run_command setgappoh "$gap_outer" >/dev/null 2>&1
    :
) &

exec "$REPO_DIR/xidouwm/xidouwm"
